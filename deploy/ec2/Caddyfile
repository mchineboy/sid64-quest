# Activate only after DNS points to EC2 and its security group permits 80/443.
sid64.quest {
	reverse_proxy https://symptom-pi.tail8762f9.ts.net:8443 {
		header_up Host {upstream_hostport}
		# Overwrite client-supplied assertions before forwarding over TLS.
		header_up X-RCK-Client-IP {remote_host}
		header_up X-RCK-Proxy-Token {$AUTH_PROXY_TOKEN}
	}
}
