[Unit]
Description=Deploy tested stable SID64 Quest releases from GitHub
After=network-online.target docker.service tailscaled.service rck.service
Wants=network-online.target

[Service]
Type=oneshot
User=tyler.hardison
WorkingDirectory=/srv/rck
ExecStart=/usr/bin/python3 /usr/local/lib/rck-release/pull.py
TimeoutStartSec=35min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/rck
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1
